# Staging local con Docker — copia a `.env` en tu PC (NUNCA commitear).
#
#   cp .env.local.example .env
#
# La VPS tiene su propio `.env` en ~/apps/insightflow/.env — no lo copies aquí.

# ── Postgres (red Compose; host = postgres) ───────────────────────────────────
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql+asyncpg://insightflow:local_dev_only_change_me@postgres:5432/insightflow

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=tu_api_key_de_gemini
# GEMINI_MODEL=gemini-3-flash-preview

# ── Telegram — USAR BOT DE PRUEBA (BotFather /newbot), NO el de producción ───
# Si usas el token de prod, el bot en la VPS dejará de recibir updates.
TELEGRAM_TOKEN=

# ── API pública local ─────────────────────────────────────────────────────────
API_PORT=8080
WORKER_URL=http://brain:8001
DATA_DIR=data
ENABLE_PUBLIC_DATA=false

# Ngrok (dev) o vacío hasta levantar túnel. Debe coincidir con el túnel activo.
PUBLIC_BASE_URL=https://nonconfidential-suprarational-sage.ngrok-free.dev

# ── Paywall / QA local ────────────────────────────────────────────────────────
FREE_MESSAGE_LIMIT=15
QUOTA_TIMEZONE=America/Bogota
# true = probar flujos premium sin pagar; false = igual que prod
DEV_FORCE_PREMIUM=true

# ── Ollama en tu PC (brain usa host.docker.internal) ──────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SEC=300

# ── Bold (opcional en local; webhook apunta a ngrok si pruebas pagos) ─────────
PREMIUM_AMOUNT_COP=40000
# BOLD_API_KEY=
# BOLD_INTEGRITY_SECRET=
# BOLD_WEBHOOK_SECRET=

# WordPress / Lovable — solo si pruebas embed contra ngrok
# CORS_ALLOWED_ORIGINS=https://www.powerupsagencia.com,https://powerupsagencia.com
# CSP_FRAME_ANCESTORS=https://www.powerupsagencia.com https://powerupsagencia.com
